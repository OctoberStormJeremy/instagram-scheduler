# ──────────────────────────────────────────────────────────────────────────────
# Instagram Scheduler — environment variables
#
# Copy this file to .env at the repo root (and/or into each app directory)
# and fill in every value before running the project.
#
# For local development you can start Postgres and Redis with:
#   docker compose up postgres redis
# ──────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (apps/api and apps/worker).
# Local default matches the docker-compose.yml service.
DATABASE_URL=******localhost:5432/instagram_scheduler


# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL used by BullMQ (apps/api and apps/worker).
REDIS_URL=redis://localhost:6379


# ── API server ────────────────────────────────────────────────────────────────
# Port the Express API listens on.
PORT=4000


# ── S3 / Cloudflare R2 media storage ─────────────────────────────────────────
# Name of the S3 bucket (or R2 bucket).
S3_BUCKET=

# AWS region. For Cloudflare R2 use "auto".
S3_REGION=us-east-1

# Custom endpoint URL. Leave blank for standard AWS S3.
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# For MinIO:        http://localhost:9000
S3_ENDPOINT=

# AWS credentials. Omit if using instance role / IAM role / workload identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base URL for media assets (used by the Instagram Graph API to pull
# the image when publishing). Must be reachable from Instagram's servers.
# e.g. https://cdn.example.com  or  https://pub-<id>.r2.dev
S3_PUBLIC_BASE_URL=


# ── Instagram / Meta ──────────────────────────────────────────────────────────
# Facebook App ID and Secret from https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# OAuth redirect URI — must be registered in the Facebook app settings.
# For local dev: http://localhost:4000/api/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=


# ── Worker ────────────────────────────────────────────────────────────────────
# Number of BullMQ jobs the worker processes concurrently.
WORKER_CONCURRENCY=1


# ── Web app (Next.js) ─────────────────────────────────────────────────────────
# Public API base URL used by the Next.js app to reach the API server.
# For local dev this is typically http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
